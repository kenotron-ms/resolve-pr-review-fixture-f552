// Public deterministic stub: oversized-field. Host-boundary qualification only; not a review.
digraph stub_oversized_field {
    label = "Stub oversized-field"
    goal = "Deterministic stub producing review-result.json in mode oversized-field."
    default_max_retries = 0
    max_pipeline_duration = "10m"
    resolve_outputs = "[\"review-result.json\"]"
    param.pr_context = "TextField:longText:PR context:optional"
    param.review_head_sha = "TextField:shortText:Head SHA:optional"

    start [label="Start", shape=Mdiamond]
    emit [label="Emit stub result", shape=parallelogram, timeout="2m", tool_env="pr_context,review_head_sha",
          tool_command="python3 -I - <<'PYEOF'
import json, os, sys
MODE = 'oversized-field'
OUT = '/project/.resolve/data/review-result.json'
ctx = json.loads(os.environ['PR_CONTEXT'])
head = os.environ['REVIEW_HEAD_SHA']
res = {'version': 1, 'repository': ctx['repository'], 'pr_number': ctx['pr_number'], 'head_sha': head,
       'conclusion': 'success', 'title': 'Deterministic stub: ' + MODE,
       'summary': 'Deterministic stub verdict for host-boundary qualification.', 'text': 'stub text'}
if MODE == 'changes':
    res['conclusion'] = 'failure'
    res['title'] = 'Changes requested (stub)'
elif MODE == 'mismatch-head':
    res['head_sha'] = '0' * 40
elif MODE == 'oversized-field':
    res['text'] = 'x' * 32001
elif MODE == 'limit-max':
    res.update(conclusion='neutral', title='t' * 200, summary='s' * 16000, text='x' * 32000)
if MODE == 'missing':
    sys.exit(0)
if MODE == 'malformed':
    data = '{' + chr(34) + 'version' + chr(34) + ': 1, ' + chr(34) + 'repository' + chr(34) + ': '
elif MODE == 'oversized-file':
    data = json.dumps(res) + ' ' * 70000
else:
    data = json.dumps(res)
with open(OUT, 'w') as stream:
    stream.write(data)
PYEOF"]
    done [label="Done", shape=Msquare]
    start -> emit
    emit -> done [condition="outcome=success"]
}
